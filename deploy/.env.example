# Copy to .env and edit. Never commit .env.

# Public host name of this server. Needs an A record and a matching PTR.
MAIL_HOST=mail.rokomari.com
# Main mail domain; also the SRS domain for forwarded mail.
PRIMARY_DOMAIN=rokomari.com

# First-run bootstrap superadmin (used only while no superadmin exists).
ADMIN_EMAIL=admin@rokomari.com
ADMIN_PASSWORD=change-me-to-something-long

# Outbound relay (e.g. Amazon SES). Empty = deliver directly to recipient MX.
# Mail sent by our users goes via the relay; forwards and bounces go direct.
RELAYHOST=
#RELAYHOST=[email-smtp.ap-southeast-1.amazonaws.com]:587
RELAY_USER=
RELAY_PASS=

# acme = real Let's Encrypt certificate via Caddy; internal = Caddy's local CA (tests).
TLS_MODE=acme

# Maximum message size in MB.
MESSAGE_SIZE_MB=25

# Secret for SRS (forward rewriting). Empty = generated once and kept in a volume.
SRS_SECRET=

TZ=Asia/Dhaka

# Optional admin app settings (defaults shown).
#SESSION_HOURS=12
#ALLOW_USER_FORWARD=false
#DEFAULT_QUOTA_MB=1024

# Optional, used by scripts/backup.sh (restic to S3).
#RESTIC_REPOSITORY=s3:https://s3.ap-southeast-1.amazonaws.com/my-bucket/rokmail
#RESTIC_PASSWORD=
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
